# =================================================================
# KAHAANI BACKEND ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Formspree Integration (All enquiries will appear in your Formspree dashboard)
FORMSPREE_URL=https://formspree.io/f/xrpbbnyv

# Supabase Database Credentials
# Find these in your Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: Service role key for admin privileges (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Email Notification Settings (SMTP)
# You can use Gmail (with App Password), Brevo, SendGrid, Amazon SES, or Hostinger/cPanel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Kahaani Website" <no-reply@kahaani.in>
KAHAANI_NOTIFICATION_EMAIL=chitrakavi@kahaani.in

# Security & CORS
ALLOWED_ORIGIN=*
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=10

